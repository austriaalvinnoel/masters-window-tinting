{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "idpage",
          "value": "Ceramic_Pro_Long_Island_Car_and_Boat_Detailing"
        }
      ],
      "destination": "/ceramic-coating",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "idpage",
          "value": "Specialty_Window_Films"
        }
      ],
      "destination": "/residential",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "idpage",
          "value": "WINDOW_TINTING_AND_CERAMIC_PRO_SERVICES"
        }
      ],
      "destination": "/window-tinting",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ]
}
